# Copy to .env on the NAS. Never commit .env or paste tokens into GitHub.

# Cloudflare Tunnel token (Zero Trust → Networks → Tunnels → your tunnel)
TUNNEL_TOKEN=

# Random secret for Shortcuts API (Authorization: Bearer ...)
# Generate: openssl rand -hex 32
API_KEY=

# Default account Shortcuts debit when asset_account is omitted
DEFAULT_ASSET_ACCOUNT=Assets:Bank:HSBC
