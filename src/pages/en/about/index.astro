---
import Layout from '../../../layouts/Layout.astro'

const localNav = {
  title: 'About',
  items: [
    { label: 'Introduction', href: '#introduction' },
    { label: 'Education', href: '#education' },
    { label: 'Experience', href: '#experience' },
    { label: 'Skills', href: '#skills' },
    { label: 'Interests', href: '#interests' },
    { label: 'CV Download', href: '#cv-download' },
  ],
};
---

<Layout
  lang="en-HK"
  title="About | Arison N."
  description="About Arison N. – Civil Engineering student & Interior Designer based in Hong Kong."
  localNav={localNav}
>
  <section id="introduction" class="about-hero">
    <div class="about-hero-photo-container">
      <figure class="about-hero-photo">
        <img
          src="/images/about/portrait.jpg"
          alt="Arison N."
          loading="eager"
        />
      </figure>
    </div>
    <div class="about-hero-inner">
      <div class="about-hero-headlines">
        <h1 class="about-hero-title">Arison NG</h1>
        <h2 class="about-hero-role">Civil Engineering • Interior Design</h2>
      </div>
    </div>
  </section>

  <section class="about-section--links">
    <div class="about-links-inner">
      <div class="about-links-grid">
        <a class="about-links-item" href="mailto:placeholder@example.com">
          <span class="about-links-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm16 4.238-7.649 5.484a.75.75 0 0 1-.702.075l-.1-.075L4 8.238V18h16Zm-1.184-2.238H5.184L12 10.926Z"></path>
            </svg>
          </span>
          <span>placeholder@example.com</span>
        </a>
        <a class="about-links-item" href="tel:+85200000000">
          <span class="about-links-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M6.62 10.79a15.05 15.05 0 0 0 6.59 6.59l2.2-2.2a1 1 0 0 1 1.02-.24c1.12.37 2.33.57 3.57.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1C10.61 21 3 13.39 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.24.2 2.45.57 3.57a1 1 0 0 1-.25 1.02z"></path>
            </svg>
          </span>
          <span>+852 0000 0000</span>
        </a>
        <a class="about-links-item" href="#">
          <span class="about-links-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M4 4h9v2H5v13.02h13V11h2v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm10 0h6v6h-2V7.41l-6.29 6.3-1.42-1.42 6.3-6.29H14z"></path>
            </svg>
          </span>
          <span>Download vCard</span>
        </a>
        <a class="about-links-item" href="#">
          <span class="about-links-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path fill="currentColor" d="M12 3a1 1 0 0 1 1 1v9.586l2.293-2.293 1.414 1.414L12 17.414l-4.707-4.707 1.414-1.414L11 13.586V4a1 1 0 0 1 1-1ZM5 19h14v2H5z"></path>
            </svg>
          </span>
          <span>Download CV</span>
        </a>
      </div>
    </div>
  </section>

  <section class="about-section--bio">
    <div class="about-bio-inner">
      <p class="about-bio-body">
        A Civil Engineering undergraduate with Interior Design background.
        After graduating from the Higher Diploma in Interior Design,
        I initially pursued a Bachelor's degree in Interior Architecture and Design.
        However, driven by a desire to master structural mechanics and contribute to larger-scale projects,
        I decided to pivot my path to Civil Engineering.
      </p>
      <p class="about-bio-body">
        During my transition period, I continued to hone my design skills as an Interior Design Assistant
        at a local studio, and as a co-worker of the Communication &amp; Interior Design team at IKEA Hong Kong.
      </p>
    </div>
  </section>

  <section id="education" class="about-specs">
    <h2 class="about-specs-title">Education</h2>
    <div class="about-specs-content">
      <div class="about-specs-group">
        <h3 class="about-specs-group-title">Bachelor of Engineering (Honours) in Civil Engineering</h3>
        <p class="about-specs-item">Hong Kong Metropolitan University</p>
        <p class="about-specs-item">2025 - 2029</p>
      </div>
      <div class="about-specs-group">
        <h3 class="about-specs-group-title">Higher Diploma in Interior Design</h3>
        <p class="about-specs-item">Hong Kong Design Institute</p>
        <p class="about-specs-item">2022 - 2024</p>
      </div>
    </div>
  </section>

  <section id="experience" class="about-specs">
    <h2 class="about-specs-title">Experience</h2>
    <div class="about-specs-content">
      <div class="about-specs-group">
        <h3 class="about-specs-group-title">Visual Merchandiser</h3>
        <p class="about-specs-item">IKEA Hong Kong</p>
        <p class="about-specs-item">2024 - 2025</p>
      </div>
    </div>
  </section>

  <section id="skills" class="about-specs">
    <h2 class="about-specs-title">Skills</h2>
    <div class="about-specs-content">
      <div class="about-specs-group">
        <h3 class="about-specs-group-title">Technical Skills</h3>
        <p class="about-specs-item">Technical skills, software tools, and interdisciplinary strengths will be listed here.</p>
      </div>
    </div>
  </section>

  <section id="interests" class="about-specs">
    <h2 class="about-specs-title">Interests</h2>
    <div class="about-specs-content">
      <div class="about-specs-group">
        <h3 class="about-specs-group-title">Personal Interests</h3>
        <p class="about-specs-item">Personal interests and creative pursuits will be shared here.</p>
      </div>
    </div>
  </section>

  <section id="cv-download" class="about-specs">
    <h2 class="about-specs-title">CV Download</h2>
    <div class="about-specs-content">
      <div class="about-specs-group">
        <h3 class="about-specs-group-title">Download</h3>
        <p class="about-specs-item">A downloadable version of the CV will be available here.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  @import '../../../styles/about.css';
</style>
